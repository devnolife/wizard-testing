# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# wizard runtime data
.wizard-data/

# nested project artifacts (e.g. fixtures/*/node_modules)
**/node_modules/
**/.next/
fixtures/**/.next/
fixtures/**/node_modules/
fixtures/**/tsconfig.json

# Local server log (dev artifact)
.server.log


# Playwright test output in fixtures
fixtures/**/test-results/

# Temp commit message / scratch files
.commitmsg.txt
.*.cjs
.*.mjs
.lhcommit.txt
